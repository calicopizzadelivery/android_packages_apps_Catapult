<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="350dp"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceContainerLow"
        android:focusable="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="end"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/dateTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    tools:text="Mon, 4 March" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceHeadlineLarge" />

            </LinearLayout>

            <!-- Two columns, like every row below it, so Sleep is exactly as
                 wide as the tile under it and Settings and Power share the
                 other column. Weights of 2:1:1 across three buttons came out
                 3dp short of that, as there is one more gap to share. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingStart="@dimen/system_options_edge"
                android:paddingEnd="@dimen/system_options_edge">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sleepMaterialButton"
                    style="@style/SystemOptionsButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/sleep"
                    app:icon="@drawable/ic_moon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clipToPadding="false">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsMaterialButton"
                        style="@style/SystemOptionsButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:icon="@drawable/ic_settings"
                        app:iconPadding="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/powerMaterialButton"
                        style="@style/SystemOptionsButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:icon="@drawable/ic_power"
                        app:iconPadding="0dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Every row has the same side padding, and the same 6dp above
                 it: the tiles line up with each other, with the clock above
                 and with the notifications below, evenly spaced. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:paddingStart="@dimen/system_options_edge"
                android:paddingEnd="@dimen/system_options_edge">

                <org.lineageos.tv.launcher.view.TwoLineButton
                    android:id="@+id/networkTwoLineButton"
                    style="@style/TwoLineSystemOptionsButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/network_status"
                    app:icon="@drawable/ic_wifi_signal_3" />

                <org.lineageos.tv.launcher.view.TwoLineButton
                    android:id="@+id/bluetoothTwoLineButton"
                    style="@style/TwoLineSystemOptionsButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/bluetooth_status"
                    app:icon="@drawable/ic_bluetooth" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/system_options_edge"
                android:paddingEnd="@dimen/system_options_edge">

                <org.lineageos.tv.launcher.view.TwoLineButton
                    android:id="@+id/screensaverTwoLineButton"
                    style="@style/TwoLineSystemOptionsButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/screensaver_status"
                    app:icon="@drawable/ic_screensaver" />

                <org.lineageos.tv.launcher.view.TwoLineButton
                    android:id="@+id/accessibilityTwoLineButton"
                    style="@style/TwoLineSystemOptionsButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/accessibility_status"
                    app:icon="@drawable/ic_accessibility" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/system_options_edge"
                android:paddingEnd="@dimen/system_options_edge">

                <org.lineageos.tv.launcher.view.TwoLineButton
                    android:id="@+id/audioOutputTwoLineButton"
                    style="@style/TwoLineSystemOptionsButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/audio_output_status"
                    app:icon="@drawable/ic_audio_output" />

                <org.lineageos.tv.launcher.view.TwoLineButton
                    android:id="@+id/panelShortcutTwoLineButton"
                    style="@style/TwoLineSystemOptionsButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/panel_shortcut_status"
                    app:icon="@drawable/ic_keyboard" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/system_options_edge"
                android:paddingEnd="@dimen/system_options_edge">

                <org.lineageos.tv.launcher.view.TwoLineButton
                    android:id="@+id/streamingTwoLineButton"
                    style="@style/TwoLineSystemOptionsButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/streaming_status"
                    app:icon="@drawable/ic_cast" />

                <!-- Half-width, like every other tile. The second slot is for
                     the video receiver when there is one. -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

            </LinearLayout>

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:background="@drawable/notification_container"
            android:clipToOutline="true"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/noNotificationAccessLinearLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_notification_access"
                    android:textAlignment="center"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/allowNotificationAccessMaterialButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/allow_notification_access" />

            </LinearLayout>

            <TextView
                android:id="@+id/noNotificationsTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_notifications"
                android:textAppearance="?attr/textAppearanceBody2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/notificationsVerticalGridView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:verticalSpacing="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:focusOutEnd="true"
                app:focusOutFront="true" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</LinearLayout>
